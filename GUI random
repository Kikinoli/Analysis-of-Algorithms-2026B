import tkinter as tk
import random
import matplotlib.pyplot as plt

def bubble_sort(arr):
    n = len(arr)
    # Bucle de Bubble Sort normal, sin animaciones
    for i in range(n):
        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]

def preparar_y_ordenar():
    # Obtener valores directamente sin validaciones
    inicio_val = int(entry_inicio.get())
    fin_val = int(entry_fin.get())
    rango_val = int(entry_rango.get())
    
    # RANDOM
    array = [random.randint(inicio_val, fin_val) for _ in range(rango_val)]
    
    #CERRAR
    ventana.destroy()
    
    print("Lista original:", array)
    bubble_sort(array)
    print("Lista ordenada:", array)
    
    # Mostrar la gráfica lineal al final
    plt.figure(figsize=(10, 6))
    # plt.plot crea una gráfica de líneas. Le agregamos 'marker' para ver los puntos
    plt.plot(array, marker='o', color='#4285F4', linestyle='-')
    plt.title("Resultado de Bubble Sort (Gráfica Lineal)")
    plt.xlabel("Índices")
    plt.ylabel("Valores")
    plt.grid(True) # Agrega una cuadrícula al fondo
    plt.show()

#Interfaz 

ventana = tk.Tk()
ventana.title("Configuración")
ventana.geometry("300x250")

tk.Label(ventana, text="Número mínimo (Inicio):").pack(pady=(10, 0))
entry_inicio = tk.Entry(ventana)
entry_inicio.pack()
entry_inicio.insert(0, "1")

tk.Label(ventana, text="Número máximo (Fin):").pack(pady=(10, 0))
entry_fin = tk.Entry(ventana)
entry_fin.pack()
entry_fin.insert(0, "100")

tk.Label(ventana, text="Cantidad de números:").pack(pady=(10, 0))
entry_rango = tk.Entry(ventana)
entry_rango.pack()
entry_rango.insert(0, "20")

btn_iniciar = tk.Button(ventana, text="Generar y Ordenar", command=preparar_y_ordenar)
btn_iniciar.pack(pady=20)

ventana.mainloop()
